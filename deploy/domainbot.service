[Unit]
Description=Dynadot DomainBot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/domainbot
ExecStart=/opt/domainbot/.venv/bin/domainbot daemon
Restart=always
RestartSec=5
EnvironmentFile=/opt/domainbot/.env

[Install]
WantedBy=multi-user.target

